<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Patrimonios.México">
    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
        <Button Text ="Centro histórico de Zacatecas" HorizontalOptions="Center" VerticalOptions="Center"
                Clicked="Button_Zacatecas"/>
        <Button Text ="Antigua Ciudad Maya y bosques tropicales protegidos de Calakmul, Campeche" HorizontalOptions="Center" VerticalOptions="Center"
                Clicked="Button_Maya"/>
        <Button Text ="Ciudad histórica fortificada de Campeche" HorizontalOptions="Center" VerticalOptions="Center"
                Clicked="Button_Campeche"/>
        <Button Text ="Paisaje de agaves y antiguas instalaciones industriales de Tequila" HorizontalOptions="Center" VerticalOptions="Center"
                Clicked="Button_Tequila"/>
        <Button Text="Volver" HorizontalOptions="End" VerticalOptions="End" Clicked="Button_Volver"/>
    </StackLayout>
</ContentPage>