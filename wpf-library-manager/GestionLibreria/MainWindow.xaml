<Window x:Class="GestionLibreria.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestionLibreria"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Activated="Window_Activated">


    <Grid HorizontalAlignment="Left" Width="800" >
        <Grid.Background>
            <SolidColorBrush Color="#243246"/>
        </Grid.Background>

        <Label Content="Clientes" Background="#6D6875" HorizontalAlignment="Left" Margin="67,58,0,0" VerticalAlignment="Top"/>
        <Label Content="Informacion de pago" Background="#6D6875" HorizontalAlignment="Left" Margin="229,58,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.457,-0.074"/>
        <Label Content="Todos los pedidos" Background="#6D6875" HorizontalAlignment="Left" Margin="449,58,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.457,-0.074"/>


        <ListBox Name="listaClientes" Background="#E5989B" Margin="10,89,616,138" MouseDoubleClick="listaClientes_MouseDoubleClick"/>
        <ListBox Name="infoPedido" Background="#E5989B" Margin="202,89,424,138"/>
        <ListBox Name="todosPedidos" Background="#E5989B" Margin="415,89,211,138"/>

        <Button Content="Insertar" Background="#B5838D" HorizontalAlignment="Left" Margin="32,353,0,0" VerticalAlignment="Top" Click="Button_InsertaCliente" Height="39" Width="61"/>
        <Button Content="Borrar" Background="#B5838D" HorizontalAlignment="Left" Margin="118,353,0,0" VerticalAlignment="Top" Click="Button_EliminaCliente" Height="39" Width="66"/>
        <Button Content="BORRAR" Background="#B5838D" HorizontalAlignment="Left" Margin="640,253,0,0" VerticalAlignment="Top" Width="56" Height="43" Click="Button_EliminaPedido" />
        <Button Content="Actualizar" HorizontalAlignment="Left" Margin="229,337,0,0" VerticalAlignment="Top" Height="46" Width="105" Click="Button_Click_2"/>

        <TextBox Name="insertaCliente" HorizontalAlignment="Left" Margin="37,328,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>




    </Grid>
</Window>
